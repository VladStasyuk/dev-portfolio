{
    "version": 2,
    "builds": [
      {
        "src": "frontend/package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": "dist" }
      }
    ],
    "routes": [
      { "src": "/profile.json", "dest": "/frontend/profile.json" },
      { "src": "/(.*)",        "dest": "/frontend/$1" }
    ]
  }